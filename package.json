{
  "name": "smoke-agent",
  "version": "0.1.0",
  "description": "Smoke tests a web page: checks that its links and buttons work and writes an HTML report.",
  "type": "module",
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "smoke-agent": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "smoke": "tsx src/cli/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paaron89/age_ex.git"
  },
  "bugs": {
    "url": "https://github.com/paaron89/age_ex/issues"
  },
  "homepage": "https://github.com/paaron89/age_ex#readme",
  "license": "ISC",
  "dependencies": {
    "commander": "^15.0.0",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
